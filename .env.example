NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_USERNAME=dormitory
DB_PASSWORD=dormitory
DB_PORT=5432
DB_DATABASE=dormitory
# Optional: DATABASE_URL overrides DB_* when supplied.
# DATABASE_URL=postgresql://dormitory:dormitory@localhost:5432/dormitory?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-characters
JWT_RESIDENT_SECRET=replace-with-a-third-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://dormitory-backoffice.techhousesoft.com,https://dormitory-mini-app.techhousesoft.com
LINE_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
PUBLIC_APP_URL=http://localhost:3102
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
